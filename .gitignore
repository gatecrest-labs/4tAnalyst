# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/
build/

# Local Claude Code settings (hooks, personal MCP config) — never overwrite on pull
.claude/settings.local.json
# Project-level Claude Code permissions (machine-specific paths, not portable)
.claude/settings.json
# Runtime user database — contains password hashes, never commit
data/users.json
# Runtime analytics DB — generated locally, never commit
data/analytics.db
data/analytics.db-shm
data/analytics.db-wal

# Generated output
output/
graphify-out/

# Local docs (superpowers skill content — not project docs)
docs/superpowers/
docs/test-results/

# Secrets and site-specific config — copy from the .example templates instead
credentials.yaml
device_zone_map.yaml

# Generated policy DB — rebuild via standards_mcp/build_policy_db.py
standards_mcp/policy_db.json
standards_mcp/policy-data/

# Local Claude Code hook scripts — machine-specific, not portable
scripts/claude-sensitive-check.sh
.githooks/post-commit

# macOS
.DS_Store
